# syntax=docker/dockerfile:1

# Dedicated image for the quote worker (no web server).

FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build:worker

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

COPY --from=builder /app/.output/worker ./.output/worker

USER node

# Required env at runtime:
# - DATABASE_URL
# Optional:
# - BRAPI_TOKEN
# - QUOTE_WORKER_STAGGER_MS
# - QUOTE_WORKER_IDLE_MS
# - QUOTE_WORKER_HEALTH_PORT
CMD ["node", "/app/.output/worker/quote-worker.mjs"]

