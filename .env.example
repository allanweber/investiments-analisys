# PostgreSQL (dev: docker compose up -d)

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/investiments



# brapi (required)

BRAPI_TOKEN=replace-with-brapi-token


# Market data logs:
# - MARKET_DATA_LOG=true: logs provider request + full response payloads
# - (unset/false): no provider request/response logs
#
# Default is `false`. Provider errors are always logged.
#
# MARKET_DATA_LOG=true


# Market quote cache TTL (skip provider requests if cache is fresh)
# Default: 12 hours
#
# MARKET_QUOTE_TTL_HOURS=12


# FX rate cache TTL (worker refreshes Yahoo FX pairs at most this often)
# Default: 24 hours
#
# FX_REFRESH_HOURS=24


# Docker entrypoint: run quote worker in the same container as the web app (default: true).
# Set false on the web service only if you deploy a dedicated worker container (/worker-entrypoint.sh).
#
# RUN_QUOTE_WORKER=true
# QUOTE_WORKER_HEALTH_PORT=8081
# QUOTE_WORKER_IDLE_MS=60000
# QUOTE_WORKER_STAGGER_MS=1000


# Better Auth — use a long random string in production

BETTER_AUTH_SECRET=replace-with-random-secret

BETTER_AUTH_URL=http://localhost:3002

# Production (Coolify / Dokploy): set public URL and origins, e.g.

# BETTER_AUTH_URL=https://invest.allanweber.dev

# BETTER_AUTH_TRUSTED_ORIGINS=https://invest.allanweber.dev,https://preview.example.com



# Optional: Google OAuth (omit to hide provider). In Google Cloud Console add
# authorized redirect URIs for production, e.g. https://invest.allanweber.dev/api/auth/callback/google

# GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET=


# Resend (OTP e e-mails transacionais de autenticação)
# Dev: omita RESEND_API_KEY para logar o OTP no console do servidor.

RESEND_API_KEY=

EMAIL_FROM=The Financial Architect <noreply@yourdomain.com>

